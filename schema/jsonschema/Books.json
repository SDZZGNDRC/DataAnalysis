{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["elapsedTime", "data"],
    "additionalProperties": false,
    "properties": {
        "elapsedTime": {
            "type": "array",
            "description": "The earliest and latest timestamp of the data",
            "items": {
                "type": "integer",
                "description": "Unix-millisecond timestamp, from 2001-01-01 00:00:00 to 2099-01-01 00:00:00",
                "minimum": 978278400000,
                "maximum": 4070880000000
            },
            "minItems": 2,
            "maxItems": 2
        },
        "data": {
            "type": "array",
            "description": "The data of the books",
            "items": {
                "type": "object",
                "required": ["arg", "data", "action"],
                "additionalProperties": false,
                "properties": {
                    "arg": {
                        "type": "object",
                        "properties": {
                            "channel": {"type": "string"},
                            "instId": {"type": "string"},
                            "instType": {"type": "string"},
                            "InstFamily": {"type": "string"},
                            "uly": {"type": "string"}
                        },
                        "required": ["channel"],
                        "additionalProperties": false
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["asks", "bids", "ts", "checksum", "prevSeqId", "seqId"],
                            "additionalProperties": false,
                            "properties": {
                                "asks": {
                                    "type": "array",
                                    "items": {
                                        "type": "array",
                                        "description": "each booklevel in the asks",
                                        "items": {
                                            "type": "string",
                                            "description": "must be a number",
                                            "pattern": "[+-]?[0-9]+(\\.[0-9]+)?$"
                                        },
                                        "minItems": 4,
                                        "maxItems": 4
                                    }
                                },
                                "bids": {
                                    "type": "array",
                                    "items": {
                                        "type": "array",
                                        "description": "each booklevel in the bids",
                                        "items": {
                                            "type": "string",
                                            "description": "must be a number",
                                            "pattern": "[+-]?[0-9]+(\\.[0-9]+)?$"
                                        },
                                        "minItems": 4,
                                        "maxItems": 4
                                    }
                                },
                                "ts": {
                                    "type": "string",
                                    "pattern": "^\\d+$"
                                },
                                "checksum": {"type": "integer"},
                                "prevSeqId": {"type": "integer"},
                                "seqId": {"type": "integer"}
                            }
                        }
                    },
                    "action": {"type": "string"}
                }
            }
        }
    }
}